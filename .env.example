# Salin file ini menjadi `.env.local` (sudah masuk .gitignore), lalu isi.
#
# Dashboard Supabase → Settings → API:
#   - Project URL              -> NEXT_PUBLIC_SUPABASE_URL
#   - publishable / anon key   -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# JANGAN menaruh secret key / service_role key di frontend.
# Keduanya hanya boleh jadi Supabase Secret untuk Edge Functions.
#
# Catatan: nilai NEXT_PUBLIC_* dibaca saat build. Setelah mengubah file ini,
# jalankan ulang `npm run dev` atau `npm run build`.
#
# Alternatif tanpa file env: pakai tombol "Konfigurasi Supabase" di navbar
# (tersimpan di localStorage browser).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
