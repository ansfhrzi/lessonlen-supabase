# Salin file ini menjadi `.env.local` lalu isi dengan data project Supabase Anda.
#
# Dashboard Supabase → Settings → API Keys
#   - Project URL           -> NEXT_PUBLIC_SUPABASE_URL
#   - Publishable / anon key -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# JANGAN menaruh secret key / service_role key di frontend.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Opsional — base URL Edge Function. Jika kosong, otomatis memakai
# ${NEXT_PUBLIC_SUPABASE_URL}/functions/v1
NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=
